      "Bash(buf:*)",
      "Bash(make:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(helm list:*)",
      "Bash(helm status:*)",
      "Bash(k3d cluster list:*)",
