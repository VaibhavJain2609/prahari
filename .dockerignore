# Docker build context exclusions. Every service image builds from the
# workspace root, so this is what stands between a `docker build` and shipping
# .env or captured government-feed snapshots inside an image.
#
# Deliberately NOT excluded: packages/prahari-proto/src/prahari/v1/*_pb2*.py —
# the stubs are gitignored but generated by `make proto` (an `images`
# prerequisite) and must reach the build context, or the prahari-proto wheel
# installs empty and every service ImportErrors at runtime.

.git
.github
.claude

# Credentials — the whole reason this file exists.
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*
secrets/

# Python caches and virtualenvs — never what an image should ship.
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info

# Node — rebuilt inside the web image via `npm ci`.
**/node_modules
web/.next
web/out

# Terraform local state and providers.
**/.terraform
*.tfstate
*.tfstate.*
crash.log

# Data that must not ship: captured /api/ingest snapshots embed gateway hosts
# and per-camera stream URLs; media dirs may hold real footage.
data/catalogue/
data/streams/
evidence/
snapshots/
clips/
*.mp4
*.mkv

# Load-test raw output and model weights (pulled at build time, never vendored).
infra/loadtest/runs/
*.pt
*.onnx
*.engine
models/

# Docs and tooling output an image does not need.
docs/
.serena/
graphify-out/
.DS_Store
