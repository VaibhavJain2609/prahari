# Copy to terraform.tfvars (gitignored) and fill in.
#
# cluster_public_access_cidrs: who may reach the public EKS API endpoint.
# Defaults to 0.0.0.0/0 — REQUIRED while GitHub-hosted runners deploy (their
# egress set exceeds the 40-CIDR cap). The endpoint is still TLS + IAM/OIDC
# authenticated. Narrow to your /32 only if you accept deploys running from
# your laptop (`make eks-up`) instead of CI.
# cluster_public_access_cidrs = ["0.0.0.0/0"]

# DNS/TLS — set to a SUBDOMAIN you control (e.g. "eks.yourdomain.com"). A
# Route53 zone + wildcard ACM cert get created; then create ONE set of NS
# records at your registrar for that subdomain pointing at
# `terraform output hosted_zone_name_servers`. Leave empty for plain-HTTP
# auto-generated LB hostnames.
# domain_name = "eks.example.com"

# Defaults shown for completeness — uncomment to override.
# region              = "ap-south-1"
# cluster_name        = "prahari-central"
# kubernetes_version  = "1.35"
# node_instance_types = ["t3.large"]
# node_desired        = 2
# node_min            = 2
# node_max            = 4
# github_repo         = "VaibhavJain2609/prahari"
# admin_principal_arns = []

tags = {
  Environment = "eks"
  Event       = "gujarat-hackathon-2026"
}
