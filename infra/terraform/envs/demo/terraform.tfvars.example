# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# ssh_public_key is the PUBLIC half only. Never put a private key, an AWS
# access key, or a database password in a tfvars file — Terraform writes
# variable values into state, and state is not an encrypted store.

region         = "ap-south-1"
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Operator egress CIDR — SSH and the k3s API accept traffic only from here.
# Find yours with `curl -s ifconfig.me` and append /32. The module rejects
# 0.0.0.0/0 on purpose: an open GPU node is a cryptomining target.
ssh_cidr = "203.0.113.10/32"
