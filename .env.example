# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# The gateway host and access password are credentials for a government camera
# feed. Keep them out of the repo, out of Helm values, out of Terraform tfvars
# and out of log lines. In the cluster they come from a Kubernetes Secret; the
# `.env` file is for local development only.

PRAHARI_GATEWAY_HOST=your-gateway-host.example
PRAHARI_GATEWAY_PASSWORD=xxxx-xxxx-xxxx
PRAHARI_GATEWAY_SCHEME=https

# RTSP/WHEP are served directly (a CDN can't proxy raw TCP/UDP media) from a
# public IP or a dedicated non-proxied subdomain, unauthenticated by the
# gateway's own design. Falls back to PRAHARI_GATEWAY_HOST when unset, but a
# real gateway usually needs this set separately.
PRAHARI_GATEWAY_DIRECT_HOST=your-gateway-direct-host-or-ip.example

# RTSP is the inference transport. If port 8554 is blocked on your network,
# set PRAHARI_INGEST_USE_HLS=1 and the pipeline falls back to
# https://<host>/<id>/index.m3u8 — at the cost of several seconds of added
# alert latency.
PRAHARI_GATEWAY_RTSP_PORT=8554
PRAHARI_GATEWAY_WHEP_PORT=8889

# Every connected client receives its OWN copy of each stream. This cap is a
# courtesy to a shared government feed, not a performance tuning knob.
PRAHARI_INGEST_MAX_ACTIVE_CAMERAS=5
PRAHARI_INGEST_SAMPLE_FPS=2

# Re-read the camera assignment on every heartbeat, so a camera the catalogue
# sync adds mid-run is picked up without a pod restart. Turn it off for a
# measured load run, where a frozen camera set is the reproducible thing to want.
PRAHARI_INGEST_ASSIGNMENT_REFRESH=1

# --- detection cascade -------------------------------------------------------
# Defaults live in DetectorSettings and are overridden by the Helm profile in
# the cluster. These are here for running a worker directly on the laptop.

# Never sniffed at runtime: cpu | videotoolbox | nvdec.
PRAHARI_DETECT_DECODE_BACKEND=cpu
PRAHARI_DETECT_MODEL=yolov8n.pt
# Batched ACROSS cameras, not within one.
PRAHARI_DETECT_BATCH_SIZE=4
PRAHARI_DETECT_MOTION_GATE=1
PRAHARI_DETECT_MATCH_ENGINE_GRPC=localhost:9001
# Set to 0 to profile the cascade with no match engine deployed.
PRAHARI_DETECT_PUBLISH_ENABLED=1

# --- shared internal credential ----------------------------------------------
# One secret, two keys, armed by `make internal-secret`. INTERNAL_TOKEN gates
# every service-to-service surface (registry /api, match-engine gRPC+admin,
# correlation /api) — empty in the pod means enforcement OFF, which is right
# for a laptop and wrong everywhere else. CREDENTIAL_KEY encrypts the camera
# stream passwords the registry stores.
INTERNAL_TOKEN=
CREDENTIAL_KEY=

# --- first login --------------------------------------------------------------
# The BFF seeds ONE bootstrap admin when the users table is empty, from the
# `prahari-bff-bootstrap` Secret — `make bff-bootstrap` creates it from these.
PRAHARI_BOOTSTRAP_ADMIN_USERNAME=
PRAHARI_BOOTSTRAP_ADMIN_PASSWORD=
